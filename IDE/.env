# CasperIDE Environment Configuration

# Gemini AI API Key for AI Assistant
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# GCP Compiler Service URL
# Replace YOUR_GCP_VM_IP with your actual GCP VM external IP address
# Example: VITE_COMPILER_SERVICE_URL=http://34.93.123.45:8080
VITE_COMPILER_SERVICE_URL=http://localhost:8081

